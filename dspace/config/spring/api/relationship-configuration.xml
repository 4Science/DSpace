<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           https://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ================================================================================ -->
    <!-- UNIFIED RELATIONSHIP CONFIGURATION (#13340)                                       -->
    <!-- Declares the configuration-backed relationships and the additional (derived)      -->
    <!-- metadata each endpoint owns. The generator-map key is the TARGET field the         -->
    <!-- enhancer writes on the owning item (here the dspace.virtual.* convention, which    -->
    <!-- keeps derived values separate from values entered by hand). The referenced         -->
    <!-- generator resolves how that value is obtained from the related entity: its own     -->
    <!-- schema.element.qualifier is the SOURCE field read on the related item. Target and  -->
    <!-- source are independent. The configuration owns the "what", the generator the "how".-->
    <!-- dspace.virtual.orcid / dspace.virtual.department are registered in the dspace       -->
    <!-- metadata schema (config/registries/dspace-types.xml).                              -->
    <!-- ================================================================================ -->

    <bean id="authorOrcidMetadataGenerator"
          class="org.dspace.content.authority.ItemSimpleAuthorityMetadataGenerator">
        <property name="authorityName" value="AuthorAuthority"/>
        <property name="keyId" value="person_identifier_orcid"/>
        <property name="schema" value="person"/>
        <property name="element" value="identifier"/>
        <property name="qualifier" value="orcid"/>
    </bean>

    <bean id="authorDepartmentMetadataGenerator"
          class="org.dspace.content.authority.ItemSimpleAuthorityMetadataGenerator">
        <property name="authorityName" value="AuthorAuthority"/>
        <property name="keyId" value="person_affiliation_name"/>
        <property name="schema" value="person"/>
        <property name="element" value="affiliation"/>
        <property name="qualifier" value="name"/>
    </bean>

    <bean id="publicationAuthorRelationship" class="org.dspace.content.RelationshipTypeConfiguration">
        <property name="id" value="publication-author"/>
        <property name="leftPrimaryMetadataField" value="dc.contributor.author"/>
        <property name="leftEntityTypes">
            <set>
                <value>Publication</value>
                <value>Product</value>
                <value>Patent</value>
            </set>
        </property>
        <property name="rightEntityTypes">
            <set>
                <value>Person</value>
            </set>
        </property>
        <property name="leftMetadataGenerators">
            <map>
                <entry key="dspace.virtual.department" value-ref="authorDepartmentMetadataGenerator"/>
                <entry key="dspace.virtual.orcid" value-ref="authorOrcidMetadataGenerator"/>
            </map>
        </property>
    </bean>

    <bean id="publicationEditorRelationship" class="org.dspace.content.RelationshipTypeConfiguration">
        <property name="id" value="publication-editor"/>
        <property name="leftPrimaryMetadataField" value="dc.contributor.editor"/>
        <property name="leftEntityTypes">
            <set>
                <value>Publication</value>
                <value>Product</value>
                <value>Patent</value>
            </set>
        </property>
        <property name="rightEntityTypes">
            <set>
                <value>Person</value>
            </set>
        </property>
        <property name="leftMetadataGenerators">
            <map>
                <entry key="dspace.virtual.department" value-ref="authorDepartmentMetadataGenerator"/>
                <entry key="dspace.virtual.orcid" value-ref="authorOrcidMetadataGenerator"/>
            </map>
        </property>
    </bean>

</beans>
