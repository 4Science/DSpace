<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="org.dspace.content.converter.ItemToItemDTOConverter" />
    <bean class="org.dspace.app.bulkimport.service.BulkImportWorkbookBuilderImpl" />

    <bean class="org.dspace.content.integration.crosswalks.StreamDisseminationCrosswalkMapper">
        <constructor-arg>
            <map>
                <!-- Crosswalk format entries are registered by later DURACOM-540 tickets
                     (e.g. bibtex, endnote, publication-apa, publication-chicago, person-xml). -->
            </map>
        </constructor-arg>
    </bean>

    <bean class="org.dspace.content.integration.crosswalks.service.ItemExportFormatServiceImpl" />

</beans>
